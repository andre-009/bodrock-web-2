{
  "name": "bodrock-web-2",
  "version": "0.1.0",
  "private": true,
  "description": "Bodrock Web Design 2.0 — governed app architecture foundation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "guard:tokens": "node scripts/check-design-system.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run guard:tokens && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}

